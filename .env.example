# Copy to .env.local (development) or set in your host's dashboard (production).

# Atomvs server (the same one the desktop app uses; production: https://api.atomvs.com). Called only from the site's server side.
SYNKRO_API_URL=http://localhost:8080

# Public URL of this website.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments — leave empty until a provider (Lemon Squeezy / Stripe) is set up.
# When empty, the Pro button says payments open soon instead of linking anywhere.
NEXT_PUBLIC_CHECKOUT_URL=
NEXT_PUBLIC_BILLING_PORTAL_URL=
